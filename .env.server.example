# Farm v1 Server Edition 环境变量示例
# 复制为 .env.server，并替换所有 CHANGE_ME 值；不要把 .env.server 提交到 Git。

FARM_IMAGE=farm-server:1.0.0
FARM_BIND_ADDRESS=0.0.0.0
FARM_HTTP_PORT=8080

MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_password
MYSQL_PASSWORD=CHANGE_ME_mysql_password
REDIS_PASSWORD=CHANGE_ME_redis_password

RUSTFS_IMAGE=rustfs/rustfs:CHANGE_ME_TESTED_TAG
RUSTFS_ACCESS_KEY=CHANGE_ME_rustfs_access_key
RUSTFS_SECRET_KEY=CHANGE_ME_rustfs_secret_key

JWT_SECRET_KEY=CHANGE_ME_jwt_secret_key
ADMIN_SECRET_KEY=CHANGE_ME_admin_secret_key

# 逗号分隔的真实前端来源，例如 http://192.168.0.10:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# v1 默认关闭监控/调度；确认设备白名单和协议后再单独开启。
FARM_TASKS_ENABLED=false
FARM_WEBSOCKET_ENABLED=true

# v2 默认只允许用户手动操作；监控也必须显式指定设备白名单
FARM_MONITOR_ENABLED=false
FARM_MONITOR_PRINTER_IDS=
FARM_SCHEDULER_ENABLED=false
FARM_SCHEDULER_MAX_ITEMS_PER_RUN=0
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
