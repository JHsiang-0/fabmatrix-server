<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.farm.mapper.PrintFileMapper">

    <!-- 文件分页查询：操作员只能查本人，管理员可按 userId 筛选或查询全部。 -->
    <select id="selectFilePage" resultType="com.example.farm.entity.PrintFile">
        SELECT *
        FROM farm_print_file
        <where>
            <choose>
                <when test="admin and filterUserId != null">
                    user_id = #{filterUserId}
                </when>
                <when test="!admin">
                    user_id = #{userId}
                </when>
            </choose>
            <if test="fileName != null and fileName != ''">
                AND original_name LIKE CONCAT('%', #{fileName}, '%')
            </if>
            <if test="materialType != null and materialType != ''">
                AND UPPER(material_type) = #{materialType}
            </if>
        </where>
        ORDER BY created_at DESC
    </select>

    <!-- SQLite 不支持 MySQL CONCAT；其它条件保持与默认语句一致。 -->
    <select id="selectFilePage" databaseId="sqlite" resultType="com.example.farm.entity.PrintFile">
        SELECT *
        FROM farm_print_file
        <where>
            <choose>
                <when test="admin and filterUserId != null">
                    user_id = #{filterUserId}
                </when>
                <when test="!admin">
                    user_id = #{userId}
                </when>
            </choose>
            <if test="fileName != null and fileName != ''">
                AND original_name LIKE '%' || #{fileName} || '%'
            </if>
            <if test="materialType != null and materialType != ''">
                AND UPPER(material_type) = #{materialType}
            </if>
        </where>
        ORDER BY created_at DESC
    </select>

    <!-- 文件目录树节点查询：权限条件在 SQL 层再次固定。 -->
    <select id="selectAccessibleFileTree" resultType="com.example.farm.entity.PrintFile">
        SELECT *
        FROM farm_print_file
        <where>
            <if test="!admin">
                user_id = #{userId}
            </if>
        </where>
        ORDER BY is_folder DESC, created_at DESC, id ASC
    </select>

    <!-- 统计指定文件的打印任务数量 -->
    <select id="countPrintJobsByFileId" resultType="java.lang.Integer">
        SELECT COUNT(*)
        FROM farm_print_job
        WHERE file_id = #{fileId}
        <if test="userId != null">
          AND user_id = #{userId}
        </if>
        <if test="status != null">
            AND status = #{status}
        </if>
    </select>

</mapper>
